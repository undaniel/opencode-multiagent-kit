#!/usr/bin/env sh
# Pre-commit rápido para Rust. La suite completa va al CI.
set -eu

git diff --cached --check

staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.rs' 'Cargo.toml' 'Cargo.lock' || true)
[ -z "$staged" ] && exit 0

if command -v cargo >/dev/null 2>&1; then
  cargo fmt --check
fi

if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --staged --redact --no-banner; then
    echo "pre-commit: gitleaks encontró posibles secretos."
    exit 1
  fi
fi

echo "pre-commit: OK"
