#!/usr/bin/env sh
# Pre-commit rápido para Java. El build completo va al CI.
set -eu

git diff --cached --check

staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.java' || true)
[ -z "$staged" ] && exit 0

if command -v google-java-format >/dev/null 2>&1; then
  google-java-format --dry-run --set-exit-if-changed $staged
fi

if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --staged --redact --no-banner; then
    echo "pre-commit: gitleaks encontró posibles secretos."
    exit 1
  fi
fi

echo "pre-commit: OK"
